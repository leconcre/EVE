# EVE - Variáveis de ambiente
# Copie este arquivo para .env e preencha com suas chaves.
# NUNCA commite o arquivo .env (ele já está no .gitignore).

# Chave da API Groq (https://console.groq.com/keys)
# Usada para geração de código e chat na nuvem
GROQ_API_KEY=

# Token do bot Discord (https://discord.com/developers/applications)
# Necessário apenas para o eve_discord_bot.py
DISCORD_BOT_TOKEN=

# Opcionais (têm valores padrão)
# OLLAMA_BASE=http://localhost:11434
# EVE_REQUEST_TIMEOUT=300
# EVE_MAX_RETRIES=2
# EVE_RETRY_BACKOFF=3.0
